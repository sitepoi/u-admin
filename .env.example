# =============================================================================
# UniconHub Platform Admin - environment template
# Copy to .env.local for local development. Never commit real values.
#
# Quick local preview without Firebase or upstream services:
#   npm run dev:demo
# =============================================================================

# --- Public Firebase configuration (safe for the browser) --------------------
# These identify the ADMIN-ONLY Firebase project. They are not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-admin-project-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=uniconhub-platform-admin.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=uniconhub-platform-admin
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:replace-me

# Dev-only: enables the E2E sign-in helper on /login.
# The server refuses to honour this when NODE_ENV=production or VERCEL=1.
NEXT_PUBLIC_PLATFORM_E2E_MODE=false

# --- Platform host and access boundary --------------------------------------
# The ONLY host this application serves. Everything else returns 404.
PLATFORM_HOST=admin.uniconhub.com
# Comma separated development hosts (host:port). Ignored when NODE_ENV=production.
PLATFORM_ALLOWED_DEV_HOSTS=localhost:3000,127.0.0.1:3000

PLATFORM_SESSION_TTL_HOURS=8
PLATFORM_REVEAL_FRESH_AUTH_SECONDS=300

# Comma separated allowlist. A Firebase account that is not listed here can
# never obtain a session, even with valid credentials and MFA.
PLATFORM_ADMIN_EMAILS=owner@uniconhub.com

# Optional comma separated CIDR/IP allowlist enforced by middleware.
# Example: 203.0.113.0/24,198.51.100.7
PLATFORM_IP_ALLOWLIST=

# --- Server-only Firebase Admin credentials (ADMIN project) -----------------
PLATFORM_FIREBASE_PROJECT_ID=uniconhub-platform-admin
PLATFORM_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@uniconhub-platform-admin.iam.gserviceaccount.com
# Escaped newlines (\n) are converted to real newlines at runtime.
PLATFORM_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# --- Secret API (server-to-server only) -------------------------------------
SECRET_API_BASE_URL=https://secret-api.uniconhub.com
SECRET_API_ADMIN_SERVICE_TOKEN=replace-with-admin-service-token
SECRET_API_TIMEOUT_MS=5000

# --- CMS system API (tenant provisioning) -----------------------------------
CMS_SYSTEM_API_BASE_URL=https://cms.uniconhub.com
CMS_SYSTEM_API_KEY=replace-with-cms-system-api-key
CMS_SYSTEM_API_TIMEOUT_MS=10000
# Optional default host suffixes used when a tenant omits cmsHost/publicwebsiteHost.
PLATFORM_CMS_HOST_SUFFIX=cms.uniconhub.com
PLATFORM_PUBLICWEBSITE_HOST_SUFFIX=publicwebsite.uniconhub.com

# --- Managed projects (cross-project tenant access) --------------------------
# Service account with read/write access to every managed project. The admin
# project stores only the project registry; tenants stay in their own projects.
# Prefer roles/datastore.user per project for Firestore tenant sources.
# Falls back to PLATFORM_REPORTING_SERVICE_ACCOUNT_JSON (read-only) when empty.
PLATFORM_PROJECTS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# --- sitepoi-relay (tenant registry) ----------------------------------------
# Firestore project that holds the applications collection. Read with the
# cross-project service account above (roles/datastore.viewer on the relay).
SITEPOI_RELAY_PROJECT_ID=sitepoi-relay

# --- Cross-tenant oversight reporting ---------------------------------------
# Dedicated read-only service account JSON (single line, escaped newlines).
PLATFORM_REPORTING_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# Optional. When set, POST /api/platform/reporting/refresh also accepts
# `Authorization: Bearer <PLATFORM_REPORTING_CRON_SECRET>` for Vercel Cron.
PLATFORM_REPORTING_CRON_SECRET=
PLATFORM_REPORTING_MAX_CONCURRENCY=3
PLATFORM_REPORTING_TENANT_TIMEOUT_MS=10000

# Tenant-project collection mapping for the aggregate collector. Adjust these
# to match the CMS schema. Only counts are stored in the admin project.
PLATFORM_REPORTING_OBJECT_COLLECTION=objects
PLATFORM_REPORTING_OBJECT_TYPE_FIELD=objectTypeId
PLATFORM_REPORTING_API_REQUEST_COLLECTION=api_requests
PLATFORM_REPORTING_API_VERSION_FIELD=apiVersion
PLATFORM_REPORTING_FIRST_PARTY_COLLECTION=first_party_requests
PLATFORM_REPORTING_FIRST_PARTY_ERROR_FIELD=isError
PLATFORM_REPORTING_USERS_COLLECTION=users
PLATFORM_REPORTING_STORAGE_COLLECTION=platform_usage

# --- Dev / E2E only ----------------------------------------------------------
# Enables the in-memory store and the test sign-in helper. Refused in production
# and never honoured on Vercel.
PLATFORM_E2E_MODE=false
PLATFORM_E2E_SESSION_SECRET=local-e2e-only-change-me

# =============================================================================
# NEVER ADD THESE (the Admin app must not be able to decrypt anything):
#   SECRETS_ENC_KEY
#   SECRETS_FINGERPRINT_KEY
#   SECRET_API_CMS_ENROLL_TOKEN
#   SECRET_API_RUNTIME_FETCH_TOKEN
# =============================================================================
